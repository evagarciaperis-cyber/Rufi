{
  "name": "rufi",
  "version": "0.1.0",
  "rufiVersion": "1.0.0",
  "private": true,
  "description": "Rufi, la mascota digital oficial de Reference Home: especificación, pipeline 3D y herramientas.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "analyze": "python3 tools/analyze_reference.py",
    "validate": "node tools/validate-glb.mjs",
    "template": "blender --background --python blender/scripts/rufi_build_template.py -- --out blender/rufi_rig_template.blend",
    "pipeline:proxy": "blender --background --python blender/scripts/rufi_build_template.py -- --out build/rufi_proxy.blend --with-proxy && blender --background build/rufi_proxy.blend --python blender/scripts/rufi_export_glb.py -- --out build/rufi_proxy.glb && node tools/validate-glb.mjs build/rufi_proxy.glb --allow-proxy",
    "optimize": "node tools/optimize-model.mjs models/original/rufianimado.glb models/rufi.web.glb --ratio 0.1 --error 0.01",
    "inspect": "node tools/inspect-model.mjs",
    "build": "node scripts/build.mjs",
    "test:e2e": "node tests/e2e/rufi.e2e.cjs",
    "validate:configs": "node tools/validate-config.mjs configs/[!_]*.json configs/ejemplos/*.json",
    "test:loader": "node tests/e2e/loader.e2e.cjs",
    "package:ftp": "node scripts/package-ftp.mjs build/aval-ico-valencia.original.html"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "esbuild": "0.28.2",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "three": "0.186.1"
  }
}
