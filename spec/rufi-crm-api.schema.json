{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://referencehome.es/rufi/schema/1.1/rufi-crm-api.schema.json",
  "title": "Comunicación Rufi ↔ CRM (rufi-crm/1): archivos públicos en Supabase Storage + API dinámica (vista previa, chat)",
  "description": "Formas exactas de los archivos públicos que el CRM publica en Supabase Storage (status.json, pages/<slug>.json, routes/<sha256>.json) y de los mensajes de la API dinámica de Vercel (vista previa y chat). Todo con additionalProperties: false: ningún campo no listado puede salir. Ver spec/rufi-crm-api.md.",
  "x-api-version": "rufi-crm/1",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 64
    },
    "iso": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "pageEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "slug",
        "status",
        "revision",
        "issuedAt",
        "expiresAt"
      ],
      "properties": {
        "api": {
          "const": "rufi-crm/1"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "status": {
          "enum": [
            "active",
            "disabled",
            "killed"
          ],
          "description": "active: hay config · disabled: página apagada · killed: Rufi apagado en todo el sitio (apagado de emergencia)"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Contador del SITIO, siempre creciente: cada publicación, apagado o encendido lo incrementa"
        },
        "engine": {
          "$ref": "#/$defs/version"
        },
        "contract": {
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "issuedAt": {
          "$ref": "#/$defs/iso"
        },
        "expiresAt": {
          "$ref": "#/$defs/iso",
          "description": "Caducidad dura: pasada esta fecha, ninguna copia (navegador, respaldo estático) puede usarse"
        },
        "preview": {
          "const": true
        },
        "config": {
          "type": "object",
          "description": "Configuración (spec/rufi-config.schema.json). Solo con status active"
        }
      }
    },
    "chatSessionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "lang"
      ],
      "properties": {
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "lang": {
          "enum": [
            "es",
            "en",
            "fr",
            "it",
            "de"
          ]
        }
      }
    },
    "chatSessionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "ticket",
        "expiresAt",
        "maxMessages"
      ],
      "properties": {
        "api": {
          "const": "rufi-crm/1"
        },
        "ticket": {
          "type": "string",
          "pattern": "^v1\\.[A-Za-z0-9_-]{16,400}\\.[A-Za-z0-9_-]{43}$"
        },
        "expiresAt": {
          "$ref": "#/$defs/iso"
        },
        "maxMessages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "chatRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticket",
        "slug",
        "lang",
        "messages"
      ],
      "properties": {
        "ticket": {
          "type": "string",
          "maxLength": 500
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "lang": {
          "enum": [
            "es",
            "en",
            "fr",
            "it",
            "de"
          ]
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "chatResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "reply",
        "remaining"
      ],
      "properties": {
        "api": {
          "const": "rufi-crm/1"
        },
        "reply": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "handoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "href"
          ],
          "properties": {
            "type": {
              "const": "whatsapp"
            },
            "href": {
              "type": "string",
              "pattern": "^https://wa\\.me/[0-9]{8,15}(\\?text=[^\\s]*)?$"
            }
          }
        },
        "remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "bad_request",
                "unauthorized",
                "forbidden",
                "not_found",
                "payload_too_large",
                "rate_limited",
                "unavailable",
                "disabled"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 200
            },
            "retryAfter": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          }
        }
      }
    },
    "previewClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "slug",
        "draft",
        "exp",
        "nonce"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "draft": {
          "type": "integer",
          "minimum": 1
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "description": "segundos Unix; máximo 600 s después de la emisión"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,64}$"
        }
      }
    },
    "localGlobal": {
      "type": "object",
      "description": "Ampliación 1.1 de /rufi/configs/_global.json (Arsys). Sin «source» → comportamiento 1.0. El cargador 1.0.0 publicado ignora «source».",
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "static"
          ],
          "properties": {
            "static": {
              "type": "string",
              "pattern": "^https://[a-z0-9-]+\\.supabase\\.co/storage/v1/object/public/rufi-public/v1$",
              "description": "Cubeta pública de Supabase (solo lectura)"
            },
            "api": {
              "type": "string",
              "pattern": "^https://[a-z0-9.-]+/api/public/rufi/v1$",
              "description": "API dinámica del CRM: solo vista previa y chat"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 500,
              "maximum": 5000
            },
            "recheckSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 3600,
              "description": "Páginas abiertas (motor ≥ 1.1.0): cada cuánto vuelve a mirar status.json y su página mientras la pestaña está visible"
            }
          }
        }
      }
    },
    "statusFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "scope",
        "status",
        "revision",
        "issuedAt",
        "expiresAt"
      ],
      "description": "v1/status.json · estado GLOBAL del sitio. Un único archivo: apagar todo el sitio es UNA escritura atómica.",
      "properties": {
        "api": {
          "const": "rufi-crm/1"
        },
        "scope": {
          "const": "site"
        },
        "status": {
          "enum": [
            "active",
            "killed"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "$ref": "#/$defs/iso"
        },
        "expiresAt": {
          "$ref": "#/$defs/iso"
        }
      }
    },
    "routeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "slug",
        "revision",
        "issuedAt",
        "expiresAt"
      ],
      "description": "v1/routes/<sha256 de la ruta normalizada>.json · solo Joomla con fragmento global. El nombre es un hash: no se pueden listar ni adivinar rutas.",
      "properties": {
        "api": {
          "const": "rufi-crm/1"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "$ref": "#/$defs/iso"
        },
        "expiresAt": {
          "$ref": "#/$defs/iso"
        }
      }
    },
    "publicObjectPath": {
      "type": "string",
      "pattern": "^v1/(status\\.json|pages/[a-z0-9-]{1,64}\\.json|routes/[0-9a-f]{64}\\.json)$",
      "description": "ÚNICAS rutas que el CRM puede escribir en la cubeta pública rufi-public. Cualquier otra se rechaza antes de subir."
    }
  }
}
