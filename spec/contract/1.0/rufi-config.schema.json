{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://referencehome.es/rufi/schema/rufi-config.schema.json",
  "title": "Configuración de Rufi para una página",
  "description": "Archivo /rufi/configs/<nombre>.json. Sin código: solo datos, para que un configurador visual pueda generarlo. Validar con: node tools/validate-config.mjs configs/<nombre>.json",
  "type": "object",
  "required": ["page", "panel"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "description": { "type": "string", "description": "Nota interna: qué página es y qué selectores usa." },
    "enabled": { "type": "boolean", "default": true, "description": "false = Rufi no se carga en esta página." },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "Versión del motor para esta página. Vacío = la de _global.json." },
    "page": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Identificador de la página (memoria de sesión: bienvenida, mensajes vistos, silencio)." },
    "test": { "type": "boolean", "description": "Página de pruebas: eventos con test: true y registro en consola." },
    "debug": { "type": "boolean" },
    "replaceSelector": { "type": ["string", "null"], "description": "Elemento existente que Rufi oculta (por ejemplo, una mascota anterior)." },
    "zIndex": { "type": "integer", "minimum": 0 },
    "position": { "enum": ["right", "left"] },
    "breakpoint": { "type": "integer", "minimum": 320 },
    "size": { "type": "object", "properties": { "mobile": { "$ref": "#/$defs/pair" }, "desktop": { "$ref": "#/$defs/pair" } }, "additionalProperties": false },
    "offset": { "type": "object", "properties": { "mobile": { "$ref": "#/$defs/pair" }, "desktop": { "$ref": "#/$defs/pair" } }, "additionalProperties": false },
    "label": { "type": "string", "description": "Texto para lectores de pantalla del botón de Rufi." },
    "intro": { "type": "object", "properties": { "delay": { "type": "integer" }, "peek": { "type": "integer" } }, "additionalProperties": false },
    "welcome": { "type": ["object", "null"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 160 } }, "required": ["text"], "additionalProperties": false },
    "bubbles": { "type": "object", "properties": { "autoHide": { "type": "integer" }, "minGap": { "type": "integer" }, "maxPerPage": { "type": "integer" }, "typingPause": { "type": "integer" } }, "additionalProperties": false },
    "sleepAfter": { "type": "integer", "minimum": 5000 },
    "maxFps": { "type": "integer", "minimum": 15, "maximum": 60 },
    "maxFpsMobile": { "type": "integer", "minimum": 15, "maximum": 60 },
    "whatsapp": { "type": "object", "properties": { "number": { "type": "string", "pattern": "^[0-9]{8,15}$" }, "message": { "type": "string" } }, "additionalProperties": false },
    "panel": {
      "type": "object",
      "required": ["title", "options"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "footnote": { "type": "string" },
        "options": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/option" } }
      }
    },
    "triggers": { "type": "array", "items": { "$ref": "#/$defs/trigger" } },
    "automation": {
      "type": "object",
      "description": "Preparación para WhatsApp/ManyChat sin chat web: códigos ref en las acciones y en el evento rufi:action.",
      "properties": { "appendRef": { "type": "boolean", "description": "true = añade [REF] al final del mensaje de WhatsApp (para disparadores por palabra clave)." }, "refPrefix": { "type": "string" } },
      "additionalProperties": false
    }
  },
  "$defs": {
    "pair": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["scroll", "whatsapp", "link", "panel", "event"] },
        "target": { "type": "string", "description": "scroll: selector CSS del destino" },
        "focus": { "type": "string", "description": "scroll: selector del elemento que recibe el foco" },
        "href": { "type": "string", "description": "link: URL (ManyChat: enlaces m.me/ig.me con ?ref=)" },
        "number": { "type": "string", "pattern": "^[0-9]{8,15}$" },
        "message": { "type": "string" },
        "ref": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": ["id", "label", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 48 },
        "hint": { "type": "string", "maxLength": 60 },
        "icon": { "enum": ["check", "calculator", "whatsapp"] },
        "ref": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "action": { "$ref": "#/$defs/action" }
      }
    },
    "trigger": {
      "type": "object",
      "required": ["id", "on", "selector", "say"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "on": { "enum": ["visible", "complete", "shown"], "description": "visible: la sección entra en pantalla · complete: aparece un elemento (match) dentro del selector · shown: el elemento deja de estar oculto" },
        "selector": { "type": "string" },
        "match": { "type": "string" },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "dwell": { "type": "integer", "minimum": 0 },
        "state": { "enum": ["curious", "happy", "greet", "idle"] },
        "expr": { "enum": ["blink", "smile"] },
        "say": { "type": "string", "minLength": 1, "maxLength": 200 },
        "once": { "type": "boolean" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
        "bubbleAction": { "$ref": "#/$defs/action" }
      }
    }
  }
}
