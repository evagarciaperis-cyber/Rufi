      { "id": "asesor", "label": "Hablar con Reference Home", "hint": "WhatsApp · +34 674 61 22 72", "icon": "whatsapp", "ref": "RUFI_PLANTILLA_ASESOR", "action": { "type": "whatsapp" } }
