{
  "$schema": "../../spec/rufi-config.schema.json",
  "enabled": false,
  "description": "PLANTILLA: copiar como configs/<nombre-de-la-pagina>.json, rellenar y poner enabled:true.",
  "page": "nombre-de-la-pagina",
  "welcome": { "text": "¡Holaaa! 👋 Soy Rufi. ¿Te echo una patita? 🏡" },
